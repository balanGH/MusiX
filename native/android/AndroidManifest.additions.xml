<?xml version="1.0" encoding="utf-8"?>
<!--
  Additions to android/app/src/main/AndroidManifest.xml.

  android/ is generated by `npx cap add android` on the build machine and is not
  tracked, so `npm run android:native` (scripts/apply-android-native.mjs) merges
  this file into it: every <uses-permission> here replaces one with the same
  name, and every attribute on <application> is set on the real <application>.
  Running it again changes nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: read audio files (MusicLibrary plugin). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 12 and older: the pre-13 equivalent. Ignored on 13+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      requestLegacyExternalStorage: on Android 10 only, lets the WebView read
      shared-storage files by absolute path (/_capacitor_file_/...). Android 11+
      allows that with the media permission alone and ignores this flag.

      usesCleartextTraffic: the optional Studio/Download server on the user's
      PC is reached over plain HTTP on the local network.
    -->
    <application
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true" />

</manifest>
