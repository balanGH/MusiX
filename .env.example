# MusiX needs no environment variables to run.
#
# The web app has no server, no API keys and no accounts — it reads your music
# from disk and stores everything in your browser. `npm run dev` is enough.
#
# The variables below configure the *optional* local stem-separation service in
# backend/. They are read by the Python process, not by the web app, and every
# one has a sensible default.

# Where separated stems and uploads are kept.
# MUSIX_STORAGE=./backend/storage

# Where downloaded songs are saved. Defaults to <storage>/downloads, and can
# also be changed in Settings. Setting it here pins the folder and disables
# the Settings control.
# MUSIX_DOWNLOAD_DIR=C:\Users\You\Music\MusiX

# Largest file the service will accept, in bytes. Default: 512 MB.
# MUSIX_MAX_UPLOAD=536870912

# Demucs model. `htdemucs` gives vocals/drums/bass/other;
# `htdemucs_6s` adds guitar and piano and is roughly twice as slow.
# Asking for guitar or piano switches to the six-stem model automatically.
# MUSIX_MODEL=htdemucs

# Force a device. Left unset, CUDA is used when it is genuinely available.
# MUSIX_DEVICE=cpu

# Where the service listens. Keep it on the loopback address: it holds your
# audio, and nothing outside this machine should reach it — unless you use
# MUSIX_LAN below, which also requires a password.
# MUSIX_HOST=127.0.0.1
# MUSIX_PORT=8000

# Password for the service. When set, every /api route except /api/health
# needs it, sent as `Authorization: Bearer <token>` (or `?token=` for audio
# and download links). Enter the same value in the app under
# Settings > PC server. Unset means no password, which is fine on 127.0.0.1.
# MUSIX_API_TOKEN=choose-a-long-random-password

# Let the Android app use Studio and Download over Wi-Fi. Listens on every
# interface (0.0.0.0) and accepts any Host header, and refuses to start unless
# MUSIX_API_TOKEN is set. Prints the address to enter on the phone at startup.
# Allow the port through the firewall (Private networks only).
# MUSIX_LAN=1

# Origins allowed to call the service, comma-separated.
# Defaults cover the Vite dev server, `npm run preview` and the Capacitor
# shells (http://localhost is the Android app). Mutating requests from any
# other origin are refused.
# MUSIX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,capacitor://localhost,https://localhost,http://localhost

# Host names the service answers to (guards against DNS rebinding). If you run
# `vite --host` and open the app by LAN address, add that address here and its
# origin above.
# MUSIX_ALLOWED_HOSTS=127.0.0.1,localhost

# Read by the web app at build time: where it reaches the service. Defaults to
# `/api`, which the Vite dev/preview proxy forwards to MUSIX_HOST:MUSIX_PORT.
# VITE_MUSIX_API_BASE=/api
